# ── Django Core Settings ──────────────────────────────────────────────
DEBUG=True
SECRET_KEY=replace-with-your-secure-random-key
DJANGO_SETTINGS_MODULE=cwconfigs.settings

# ── Database & Redis Config ──────────────────────────────────────────
POSTGRES_DB=cwdb
POSTGRES_USER=cwadmin
POSTGRES_PASSWORD=cw123456
POSTGRES_HOST=cwdb
POSTGRES_PORT=5432

REDIS_HOST=cwredis
REDIS_PORT=6379

# ── AI Model Providers (Enter your API Keys here) ─────────────────────

# 1. Anthropic (Recommended for Creative Copy & Scriptwriting)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 2. OpenAI (Recommended for Thumbnails & GPT-4o Agent Tasks)
OPENAI_API_KEY=your-openai-api-key-here

# 3. Google Gemini (Recommended for Large RAG Guideline Audits)
GEMINI_API_KEY=your-gemini-api-key-here

# ── Logging & Celery Settings ─────────────────────────────────────────
CELERY_LOG_LEVEL=info
